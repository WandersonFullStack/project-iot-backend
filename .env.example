# PostgreSQL
POSTGRES_DB=system_iot
POSTGRES_USER=mqttgateway
# Use apenas caracteres URL-safe porque a senha compõe DATABASE_URL.
POSTGRES_PASSWORD=change-this-database-password

# API/JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_EXPIRE_MIN=30
REFRESH_EXPIRE_DAYS=7

# MQTT com autenticação e TLS
MQTT_USERNAME=backend
MQTT_PASSWORD=change-this-mqtt-password
MQTT_CLIENT_ID=mqtt_gateway_backend

# Domínio usado por clientes MQTT externos.
# O certificado também sempre inclui o nome interno "mosquitto".
MQTT_CERT_HOST=mqtt.example.com
